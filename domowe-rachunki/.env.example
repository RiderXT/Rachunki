# Skrzynka, na którą przychodzą maile z wodociągów (IMAP).
# Gmail: IMAP_HOST=imap.gmail.com, a jako hasło wpisz "hasło aplikacji" (wymaga weryfikacji dwuetapowej)
IMAP_HOST=imap.example.com
IMAP_USER=ty@example.com
IMAP_PASSWORD=haslo-aplikacji
IMAP_FOLDER=INBOX

# Adres nadawcy maili z fakturą za wodę (dokładny adres lub fragment)
WATER_SENDER=faktury@twoje-wodociagi.pl
# Które linki w mailu uznać za link do dokumentu (regex, bez rozróżniania wielkości liter).
# Nie kończ regexa znakiem | - pusta alternatywa pasuje do KAŻDEGO linku w mailu.
WATER_LINK_REGEX=greenmail24\.pl/PublicForms
# Tekst przycisku/linku na stronie pośredniej, który pobiera PDF
WATER_DOWNLOAD_TEXT=pobierz
# Jak daleko wstecz szukać maili (pierwsze uruchomienie = backfill)
WATER_SINCE_DAYS=400
SYNC_INTERVAL_HOURS=6

# Na hoście (opcjonalnie): gdzie trzymać PDF-y, np. zamontowany udział NFS z Synology
# PDF_HOST_DIR=/mnt/synology/rachunki

# Opcjonalne hasło do panelu (puste = bez hasła). Faktury zawierają dane osobowe, więc warto ustawić.
# APP_PASSWORD=wpisz-haslo

# PGNiG eBOK (nieoficjalne API; tylko do własnego konta). Na razie używane przez: python -m app.pgnig --probe
# PGNIG_LOGIN=twoj-email-lub-identyfikator
# PGNIG_PASSWORD=haslo-do-ebok
